# Nuxt dev/build outputs
.output
.data
.nuxt
.nitro
.cache
dist

# Node dependencies
node_modules

# Logs
logs
*.log
npm-debug.log*
yarn-error.log*

# Misc
.DS_Store
.fleet
.idea
.vscode

# Deploy
.vercel

# Local env files
.env
.env.*
!.env.example

# Firmware secrets — copy the .example files and fill them in locally
firmware/**/secrets.yaml
firmware/**/secrets.h

# Firmware build artefacts
firmware/**/.esphome/
firmware/**/.pio

# Credentials and key material — never commit these
*.pem
*.key
*.p12
*.pfx
*.keystore
service-account*.json

# Demo video — uploaded to GitHub as a release/issue attachment, not committed
docs/screenshots/*.mp4
docs/screenshots/*.mov
