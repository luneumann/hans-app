# Copy to secrets.yaml (git-ignored) and fill in.

wifi_ssid: "YOUR_WIFI_SSID"
wifi_password: "YOUR_WIFI_PASSWORD"
ota_password: "pick-something-long"
# Generate with: esphome secrets  (or any 32-byte base64 string)
api_encryption_key: "GENERATE_A_32_BYTE_BASE64_KEY"

# Where the panel pulls its frame from. Must be reachable from the device —
# during bring-up that is your Mac on the LAN, later the deployed app.
# The token has to match EPAPER_TOKEN in the app's environment.
hans_dashboard_url: "http://192.168.1.42:3000/api/epaper.png?token=YOUR_EPAPER_TOKEN"

# For the panel's own SHT4x readings. Same anon key the sparrows use — it is
# INSERT-only under RLS.
supabase_readings_url: "https://YOUR_PROJECT.supabase.co/rest/v1/sensor_readings"
supabase_anon_key: "YOUR_SUPABASE_ANON_KEY"
supabase_auth_header: "Bearer YOUR_SUPABASE_ANON_KEY"
