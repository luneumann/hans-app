SUPABASE_URL=
SUPABASE_KEY=

# Server-side only. The anon key above is INSERT-only under RLS, so the e-paper
# endpoint needs the service role key to read sensor_readings without a user
# session. Never expose this to the browser. SUPABASE_SERVICE_KEY is accepted
# as an alias.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret the display appends as ?token=... — required outside dev.
EPAPER_TOKEN=

# Comma-separated hosts the Vite dev server accepts besides localhost. The
# e-paper panel fetches by LAN IP, which Vite otherwise rejects with a 426.
DEV_ALLOWED_HOSTS=
